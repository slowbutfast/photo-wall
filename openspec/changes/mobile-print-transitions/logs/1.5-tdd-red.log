+     let lastTiltSx: string | null = null;
+     let lastTiltSy: string | null = null;
+     let lastSheenTransform: string | null = null;
+     let lastSheenOpacity: string | null = null;
+
+     const unsubscribe = gyroSubscribe((tilt: TiltVector) => {
