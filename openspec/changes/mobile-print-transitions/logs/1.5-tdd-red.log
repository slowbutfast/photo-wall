+
+   return (
+     <div className={`photo-cell${focused ? ' is-focused-cell' : ''}`}>
+       <button
+         type="button"
+         ref={frameRef}
+         className={`photo-frame is-lit${focused ? ' focused' : ''}`}
+         style={{
+           width: frameSize.width,
+           height: frameSize.height,
+           ...(lightingVars ?? {}),
+         }}
+         onClick={(event) => {
