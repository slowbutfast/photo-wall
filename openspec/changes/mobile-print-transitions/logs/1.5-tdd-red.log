        x: album.position.x + gridLeft + grid.grid.width / 2,
        y: album.position.y + gridTop - grid.grid.height / 2,
        width: grid.grid.width,
        height: grid.grid.height,
      };
      padding = 0.06;
    } else {
      bounds = {
        x: album.position.x,
        y: album.position.y,
        width: album.bounds.width,
        height: album.bounds.height,
      };
