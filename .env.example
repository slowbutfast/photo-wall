# Self-hosted Node.js MVP. Copy to .env.local and fill in local values.
DATABASE_URL="file:./data/photo-wall.db"

# Owner login. Use a long random password (at least 16 characters; shorter values are rejected).
ADMIN_PASSWORD="change-me-to-16-plus-chars"
# 32+ random bytes, base64 or hex. Used to sign the HttpOnly session cookie.
AUTH_SECRET="change-me-to-a-long-random-secret"

# "local" (development default) or "bunny" (production CDN).
STORAGE_DRIVER="local"
LOCAL_UPLOAD_DIR="./data/uploads"
CDN_BASE_URL="http://localhost:3000/api/local-uploads"

# Bunny.net Storage + Pull Zone (only when STORAGE_DRIVER=bunny)
BUNNY_STORAGE_ZONE=""
BUNNY_STORAGE_HOST="storage.bunnycdn.com"
BUNNY_STORAGE_API_KEY=""
BUNNY_PULL_ZONE_URL=""
BUNNY_PULL_ZONE_API_KEY=""
