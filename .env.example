# Self-hosted Node.js MVP. Copy to .env.local and fill in local values.
DATABASE_URL="file:./data/photo-wall.db"
# Turso auth token (hosted libSQL only). Never put it in DATABASE_URL.
# On Vercel the Turso integration injects TURSO_DATABASE_URL / TURSO_AUTH_TOKEN, which are
# read as fallbacks when DATABASE_URL / DATABASE_AUTH_TOKEN are unset.
DATABASE_AUTH_TOKEN=""

# Owner login. Use a long random password (at least 16 characters; shorter values are rejected).
ADMIN_PASSWORD="change-me-to-16-plus-chars"
# 32+ random bytes, base64 or hex. Used to sign the HttpOnly session cookie.
AUTH_SECRET="change-me-to-a-long-random-secret"
# Extra hosts allowed in the admin Origin check (comma-separated). Needed when a proxy such as the
# portfolio rewrite does not forward x-forwarded-host.
# TRUSTED_ORIGIN_HOSTS="gregory-lazatin.com,www.gregory-lazatin.com"

# "local" (development default) or "bunny" (production CDN).
STORAGE_DRIVER="local"
LOCAL_UPLOAD_DIR="./data/uploads"
# Optional (STORAGE_DRIVER=bunny only): set only when using a custom CDN hostname.
# When set, CDN_BASE_URL wins over BUNNY_PULL_ZONE_URL for public photo URLs and the CSP img-src;
# cache purges still use BUNNY_PULL_ZONE_URL. Ignored by the local driver (which uses /photos/api/local-uploads).
# CDN_BASE_URL="https://cdn.gregory-lazatin.com"

# Bunny.net Storage + Pull Zone (only when STORAGE_DRIVER=bunny)
BUNNY_STORAGE_ZONE=""
BUNNY_STORAGE_HOST="storage.bunnycdn.com"
BUNNY_STORAGE_API_KEY=""
BUNNY_PULL_ZONE_URL=""
BUNNY_PULL_ZONE_API_KEY=""
